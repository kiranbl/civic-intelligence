generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Channel {
  TEXT
  VOICE
  MESSAGING
}

enum AreaType {
  RURAL
  URBAN
  UNKNOWN
}

enum Category {
  WATER
  ROADS
  HEALTHCARE
  EDUCATION
  SANITATION
  TRANSPORT
  ELECTRICITY
  OTHER
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model District {
  id                   Int                    @id @default(autoincrement())
  name                 String
  state                String
  population           Int
  ruralPopulation      Int?
  urbanPopulation      Int?
  populationSource     String?
  populationSourceYear Int?
  latitude             Float?
  longitude            Float?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  requests             CitizenRequest[]
  infrastructure       InfrastructureMetric[]

  @@unique([name, state])
}

model CitizenRequest {
  id           Int      @id @default(autoincrement())
  districtId   Int
  originalText String   @db.Text
  language     String
  channel      Channel
  category     Category
  areaType     AreaType @default(UNKNOWN)
  subcategory  String?
  urgency      Urgency?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  district     District @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([districtId, createdAt])
}

model InfrastructureMetric {
  id         Int       @id @default(autoincrement())
  districtId Int
  metricType String
  value      Float
  unit       String
  source     String
  sourceYear Int
  sourceDate DateTime?
  sourceUrl  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  district   District  @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([districtId, metricType])
}
