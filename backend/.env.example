PORT=3000
# Exact comma-separated origins. In production set NODE_ENV=production and HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/civic_intelligence"
# Aiven/Render format (replace placeholders; mount CA using a Render secret file):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslcert=/etc/secrets/aiven-ca.pem&sslaccept=strict"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
