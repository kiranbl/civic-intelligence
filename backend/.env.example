PORT=3000
# Exact comma-separated origins. In production set NODE_ENV=production and HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/civic_intelligence"
# Aiven/Render format (replace placeholders; mount CA using a Render secret file):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslcert=/etc/secrets/aiven-ca.pem&sslaccept=strict"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Speech uses server-only Application Default Credentials; never commit the JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
# Direct local server: 0. On Render omit to trust its nearest ingress (1 hop).
# Set an explicit count only after verifying your deployed proxy chain.
# TRUST_PROXY_HOPS=0
