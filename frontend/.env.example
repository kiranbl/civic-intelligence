# VITE_ variables are public in the browser. Never put secrets here.
VITE_API_BASE_URL=http://localhost:3000/api

# Public browser configuration. Restrict by website and Maps JavaScript API + Places API (New).
VITE_GOOGLE_MAPS_API_KEY=
# Explicit JavaScript Map ID required; use a real project Map ID in production.
VITE_GOOGLE_MAPS_MAP_ID=
